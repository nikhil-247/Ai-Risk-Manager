# Copy to .env and replace blank secrets before starting Docker Compose.
# Generate URL-safe secrets with: python -c "import secrets; print(secrets.token_urlsafe(48))"
POSTGRES_PASSWORD=
RISKLENS_JWT_SECRET=
RISKLENS_ENV=development
RISKLENS_REDIS_URL=redis://redis:6379/0
RISKLENS_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
RISKLENS_BOOTSTRAP_ADMIN_PASSWORD=
RISKLENS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RISKLENS_PUBLIC_APP_URL=http://localhost:5173
# SMTP is optional for local development; recovery/invitation links are logged locally.
RISKLENS_SMTP_HOST=
RISKLENS_SMTP_PORT=587
RISKLENS_SMTP_USERNAME=
RISKLENS_SMTP_PASSWORD=
RISKLENS_EMAIL_FROM=
